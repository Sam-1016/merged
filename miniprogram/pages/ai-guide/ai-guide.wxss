.head {
  display: flex;
  align-items: flex-start;
  margin-top: 16rpx;
}

.ai-badge {
  width: 84rpx;
  height: 84rpx;
  border-radius: 26rpx;
  background: var(--pine);
  color: #f6f1e8;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.head-body {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.head-title {
  display: block;
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.3;
}

.head-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.topic-bar {
  margin-top: 32rpx;
  white-space: nowrap;
}

.bubble {
  margin-top: 24rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
}

.bubble-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bubble-from {
  font-size: 22rpx;
  letter-spacing: 3rpx;
  color: var(--persimmon);
}

.bubble-state {
  font-size: 22rpx;
  color: var(--faint);
}

.bubble-state.done {
  color: var(--pine);
}

.bubble-text {
  display: block;
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.9;
  white-space: pre-wrap;
  min-height: 200rpx;
}

.cursor {
  color: var(--persimmon);
  animation: blink 0.8s steps(1) infinite;
}

@keyframes blink {
  50% { opacity: 0; }
}

.bubble-foot {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mini-btn {
  height: 60rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--pine-soft);
  color: var(--pine);
  font-size: 24rpx;
  display: flex;
  align-items: center;
}

.foot-tip {
  font-size: 22rpx;
  color: var(--faint);
}
