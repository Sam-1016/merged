.page {
  min-height: 100vh;
  padding: 24rpx 32rpx;
  /* 底部留白，避免卡片被悬浮按钮遮挡 */
  padding-bottom: calc(220rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

.page-head {
  padding-top: 18rpx;
}

.cards {
  margin-top: 40rpx;
}

.g-card {
  margin-bottom: 28rpx;
  padding: 30rpx 32rpx;
  border-radius: 28rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
}

.g-card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.g-card-title {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
}

.g-card-dest {
  flex: none;
  margin-left: 20rpx;
  font-size: 24rpx;
  color: var(--persimmon);
}

.g-card-tags {
  margin-top: 18rpx;
}

.tag.price {
  background: var(--pine);
  color: #f6f1e8;
}

.tag.kw {
  background: var(--sand);
  color: var(--muted);
}

/* 底部居中悬浮圆形加号 */
.fab {
  position: fixed;
  left: 50%;
  bottom: calc(48rpx + constant(safe-area-inset-bottom));
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 20;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--pine);
  color: #f6f1e8;
  font-size: 64rpx;
  line-height: 108rpx;
  text-align: center;
  transform: translateX(-50%);
  box-shadow: 0 12rpx 32rpx rgba(31, 77, 58, 0.35);
}

.fab-hover {
  opacity: 0.85;
  transform: translateX(-50%) scale(0.94);
}

.g-card-foot {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line);
  display: flex;
  justify-content: flex-end;
}
.pub-btn {
  font-size: 24rpx;
  color: var(--pine);
  font-weight: 600;
  padding: 8rpx 20rpx;
  border: 1rpx solid var(--pine);
  border-radius: 999rpx;
}
.pub-state {
  font-size: 24rpx;
  color: var(--faint);
}
