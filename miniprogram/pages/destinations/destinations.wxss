.page-head {
  padding-top: 18rpx;
}

.search-line {
  margin-top: 28rpx;
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
}

.s-ph {
  margin-left: 12rpx;
  color: var(--faint);
  font-size: 26rpx;
}

.d-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 16rpx;
}

.d-card {
  position: relative;
  width: 332rpx;
  height: 440rpx;
  margin-bottom: 22rpx;
  border-radius: 28rpx;
  overflow: hidden;
}

.d-card image {
  width: 100%;
  height: 100%;
}

.d-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 240rpx;
  background: linear-gradient(180deg, rgba(20, 14, 10, 0), rgba(20, 14, 10, 0.78));
}

.d-temp {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(251, 249, 246, 0.9);
  color: var(--ink);
  font-size: 22rpx;
}

.d-copy {
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  bottom: 22rpx;
  color: #f7f3ed;
}

.d-area {
  display: block;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.d-name {
  display: block;
  margin-top: 6rpx;
  font-size: 40rpx;
  font-weight: 600;
}

.d-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(247, 243, 237, 0.82);
}
