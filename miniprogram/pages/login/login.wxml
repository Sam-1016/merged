<view class="page">
  <view class="brand">
    <text class="brand-name">漫途</text>
    <text class="brand-slogan">登录后同步你的资料与足迹</text>
  </view>

  <!-- 微信原生头像昵称填写能力 -->
  <view class="form-card">
    <view class="row">
      <text class="label">头像</text>
      <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <image class="avatar" src="{{avatar}}" mode="aspectFill" />
        <text class="avatar-tip">点击更换</text>
      </button>
    </view>

    <view class="row">
      <text class="label">昵称</text>
      <input class="input" type="nickname" placeholder="点击填写微信昵称" value="{{name}}" bindinput="onName" />
    </view>

    <view class="row">
      <text class="label">城市</text>
      <input class="input" placeholder="常住城市（选填）" value="{{city}}" bindinput="onCity" />
    </view>

    <view class="row row-top">
      <text class="label">签名</text>
      <textarea class="textarea" placeholder="一句话介绍自己（选填）" value="{{bio}}" bindinput="onBio" auto-height />
    </view>
  </view>

  <view class="login-btn" bindtap="onLogin" hover-class="btn-hover">一键登录</view>

  <view class="agreement">登录即代表同意《用户协议》与《隐私政策》（演示环境）</view>
</view>
