/* ============================================================
   登录页样式（小程序原生 WXSS，复用 app.wxss 全局变量）
   ============================================================ */
.page {
  min-height: 100vh;
  padding: 48rpx 32rpx;
  padding-bottom: calc(80rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

.brand {
  padding: 60rpx 0 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-name {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--pine);
  letter-spacing: 8rpx;
}

.brand-slogan {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--faint);
}

.form-card {
  border-radius: 28rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  padding: 8rpx 32rpx;
}

.row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.row:last-child {
  border-bottom: none;
}

.row-top {
  align-items: flex-start;
}

.label {
  width: 96rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: var(--muted);
}

/* 头像选择按钮（微信原生 open-type） */
.avatar-btn {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 0;
  margin: 0;
  background: transparent;
  line-height: normal;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--pine-soft);
}

.avatar-tip {
  margin-left: 20rpx;
  font-size: 24rpx;
  color: var(--faint);
}

.input {
  flex: 1;
  font-size: 28rpx;
  min-height: 60rpx;
}

.textarea {
  flex: 1;
  font-size: 28rpx;
  min-height: 80rpx;
  line-height: 1.6;
}

.login-btn {
  margin-top: 56rpx;
  padding: 26rpx 0;
  border-radius: 999rpx;
  background: var(--pine);
  color: #f6f1e8;
  font-size: 32rpx;
  text-align: center;
  box-shadow: 0 12rpx 32rpx rgba(31, 77, 58, 0.25);
}

.btn-hover {
  opacity: 0.85;
}

.agreement {
  margin-top: 32rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--faint);
}
