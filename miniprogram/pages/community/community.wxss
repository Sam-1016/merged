/* ============================================================
   社区广场页样式（小程序原生 WXSS，复用 app.wxss 全局变量）
   ============================================================ */
.page {
  min-height: 100vh;
  padding: 24rpx 32rpx;
  padding-bottom: calc(220rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

.page-head {
  padding-top: 18rpx;
}

.cards {
  margin-top: 40rpx;
}

.c-card {
  margin-bottom: 28rpx;
  padding: 30rpx 32rpx;
  border-radius: 28rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
}

.c-card-title {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
}

.c-card-meta {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.c-dest {
  font-size: 24rpx;
  color: var(--persimmon);
}

.c-time {
  font-size: 22rpx;
  color: var(--faint);
}

.c-excerpt {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: var(--muted);
  line-height: 1.6;
}

.c-card-tags {
  margin-top: 18rpx;
}

.tag.price {
  background: var(--pine);
  color: #f6f1e8;
}

.c-card-foot {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.c-author {
  display: flex;
  align-items: center;
}

.c-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--pine-soft);
  color: var(--pine);
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.c-name {
  margin-left: 14rpx;
  font-size: 24rpx;
  color: var(--muted);
}

/* 底部居中固定悬浮圆形加号按钮（参赛要求：固定、圆形、醒目） */
.fab {
  position: fixed;
  left: 50%;
  bottom: calc(48rpx + constant(safe-area-inset-bottom));
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 20;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--pine);
  color: #f6f1e8;
  font-size: 64rpx;
  line-height: 108rpx;
  text-align: center;
  transform: translateX(-50%);
  box-shadow: 0 12rpx 32rpx rgba(31, 77, 58, 0.35);
}

.fab-hover {
  opacity: 0.85;
  transform: translateX(-50%) scale(0.94);
}
