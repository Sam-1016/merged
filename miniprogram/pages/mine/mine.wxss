.profile {
  display: flex;
  align-items: center;
  padding-top: 28rpx;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  flex: none;
}

.profile-body {
  margin-left: 24rpx;
  min-width: 0;
}

.name {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
}

.bio {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.5;
}

.city {
  display: inline-block;
  margin-top: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: var(--pine-soft);
  color: var(--pine);
  font-size: 22rpx;
}

.edit {
  margin-top: 24rpx;
  height: 72rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(31, 77, 58, 0.28);
  color: var(--pine);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.stats {
  display: flex;
  margin-top: 28rpx;
  padding: 28rpx 0;
  border-top: 1rpx solid var(--line);
  border-bottom: 1rpx solid var(--line);
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-num {
  display: block;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 44rpx;
}

.stat-lbl {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.draft-banner {
  margin-top: 28rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  background: var(--pine);
  color: #f6f1e8;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.draft-kicker {
  display: block;
  font-size: 22rpx;
  letter-spacing: 3rpx;
  color: #e7c2a4;
}

.draft-title {
  display: block;
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.draft-go {
  font-size: 24rpx;
  padding-bottom: 4rpx;
  border-bottom: 1rpx solid rgba(246, 241, 232, 0.5);
}

.foot-head {
  margin-top: 48rpx;
}

.film {
  width: 100%;
  height: 210rpx;
  margin-top: 18rpx;
  white-space: nowrap;
}

.shot {
  display: inline-block;
  width: 200rpx;
  vertical-align: top;
  white-space: normal;
}

.shot image {
  width: 200rpx;
  height: 140rpx;
  border-radius: 18rpx;
}

.shot-name {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
}

.menu {
  margin-top: 36rpx;
  background: var(--card);
  border-radius: 28rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-copy {
  flex: 1;
  min-width: 0;
}

.menu-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.menu-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.version {
  margin-top: 36rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--faint);
  letter-spacing: 2rpx;
}
